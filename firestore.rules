rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can read and write only their own progress document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Revision notebook: one document per note (astra.js / auth.js).
      match /notes/{noteId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && noteId.size() <= 40
          && (!('body' in request.resource.data) || request.resource.data.body.size() <= 25000)
          && (!('title' in request.resource.data) || request.resource.data.title.size() <= 300);
      }
    }
  }
}
